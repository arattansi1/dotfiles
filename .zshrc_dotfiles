#!/bin/zsh
# Custom zsh configuration sourced by ~/.zshrc
# This file is managed by the dotfiles repo and should not be edited directly in $HOME.

if [ -d "$HOME/.oh-my-zsh" ]; then
  export ZSH="${HOME}/.oh-my-zsh"
  ZSH_THEME="linuxonly"
  source "$ZSH/oh-my-zsh.sh"
fi

# Switch to main, pull changes, rebase current branch on main
sync() {
  branch=$(git symbolic-ref --short HEAD)
  git checkout main && git pull && git checkout "$branch" && git rebase main
}

export PATH="$PATH:$HOME/bin"

source "$HOME/.aliases"
